# ─────────────────────────────────────────────────────────────────────────────
# Haseeb AI — environment configuration
# Copy to .env.local (local) or add to Vercel → Project → Settings → Environment
# Variables NEVER reach the browser: everything is used in server code only.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. AI (required for the assistant) ───────────────────────────────────────
# Vercel AI Gateway API key. Create at https://vercel.com/dashboard → AI Gateway → API Keys.
# On Vercel you can omit this: the Gateway is reachable through OIDC automatically.
AI_GATEWAY_API_KEY=
# Optional: override the model used by the agent (any AI Gateway model id).
AI_MODEL=openai/gpt-5.6-sol
# Optional: smaller model for cheap sub-tasks (titles, summaries).
AI_MODEL_FAST=openai/gpt-5.6-mini

# ── 2. Database (switchable engine, see README) ──────────────────────────────
# Leave empty for the built-in SQLite engine (local dev / single-container deploys).
# Production on Vercel: point this at a Postgres instance (Neon, Supabase, Vercel Postgres…).
#   postgres://user:password@host:5432/dbname?sslmode=require
# To force a local SQLite file, use: sqlite:./.data/haseeb-ai.db
DATABASE_URL=
# Fail fast instead of falling back to SQLite (recommended on Vercel production).
REQUIRE_POSTGRES=false

# ── 3. Authentication (required) ─────────────────────────────────────────────
# 32+ random chars. Signs sessions + CSRF tokens. Generate: openssl rand -hex 32
AUTH_SECRET=
# The single private account. Used only by the first-run setup screen
# (GET /login → "First-run setup") — there is no public signup route.
OWNER_EMAIL=haseeb@example.com
OWNER_NAME=Haseeb
# Optional bootstrap password (min 10 chars). If empty, you set it on the setup screen.
OWNER_PASSWORD=
# Optional: allow-list of extra email addresses that may sign in (comma separated).
# Leave empty for strictly single-user mode. Adding a user grants a private workspace.
ALLOWED_EMAILS=
# Optional: public URL of the deployment, used for absolute links in emails/exports.
APP_URL=http://localhost:3000

# ── 4. Web research ──────────────────────────────────────────────────────────
# Search provider — supply at least one, otherwise the agent reports web search
# as UNCONFIGURED instead of inventing results.
TAVILY_API_KEY=            # https://tavily.com  (recommended: returns page content)
BRAVE_SEARCH_API_KEY=      # https://brave.com/search/api/
SERPER_API_KEY=            # https://serper.dev

# ── 5. Email provider (drafting works without it; sending requires it) ────────
# Either a generic SMTP mailbox or Resend (HTTPS, no SMTP ports needed).
EMAIL_PROVIDER=            # resend | smtp   (empty = sending unavailable)
EMAIL_FROM="Haseeb AI <ai@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── 6. WhatsApp provider (official Business API only) ───────────────────────
# Drafting works without it; sending requires it. No unofficial automation.
WHATSAPP_PROVIDER=          # meta | twilio   (empty = sending unavailable)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── 7. Calendar provider (booking requires it) ──────────────────────────────
CALENDAR_PROVIDER=          # calcom | calendly  (empty = booking unavailable)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=

# ── 8. Website QA screenshots (optional) ────────────────────────────────────
# Without a screenshot provider, audits run with HTTP/DOM analysis and report
# "screenshot: unavailable" — they never claim a screenshot exists.
SCREENSHOT_PROVIDER=        # urlbox | browserless | none
URLBOX_API_KEY=
BROWSERLESS_API_KEY=

# ── 9. Storage for uploaded files ───────────────────────────────────────────
# local  → files stay on disk under .data/uploads (default, private)
# vercel → Vercel Blob (requires BLOB_READ_WRITE_TOKEN)
FILE_STORAGE=local
BLOB_READ_WRITE_TOKEN=

# ── 10. Operational limits ──────────────────────────────────────────────────
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
ALLOW_PRIVATE_NETWORK_FETCH=false   # keep false: blocks SSRF to internal hosts
