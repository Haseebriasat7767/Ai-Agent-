# ─────────────────────────────────────────────────────────────────────────────
# Haseeb AI — Vercel production environment template
#
# This repo deploys as ONE Next.js project (see vercel.json). There are no
# separate services and no service bindings: every browser call in this app is
# a same-origin relative request (fetch("/api/...")), so nothing needs an
# internal URL.
#
# How to use: Vercel → Project → Settings → Environment Variables, add each
# row for the Production (and Preview, if you want previews to work) targets.
# Do NOT upload this file anywhere and do NOT commit real values.
#
# Required rows are marked [REQUIRED]. Everything else degrades honestly:
# unset providers report as "unavailable" in Settings → Integrations instead
# of inventing results.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Database ──────────────────────────────────────────────────────────────
# [REQUIRED] Vercel's filesystem is read-only (only /tmp is writable) and is
# not shared between invocations, so the local SQLite fallback cannot work in
# production. Point this at a real Postgres instance (Neon, Supabase, Vercel
# Postgres…). Apply the schema once: psql "$DATABASE_URL" -f db/schema.sql
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# [REQUIRED] Makes that a hard requirement instead of a silent fallback.
# With this set, a missing/non-Postgres DATABASE_URL makes the app fail loudly
# (DatabaseUnavailableError, surfaced by /api/health) rather than trying to
# create .data/haseeb-ai.db on a read-only filesystem.
REQUIRE_POSTGRES=true


# ── 2. Authentication ────────────────────────────────────────────────────────
# [REQUIRED] 32+ random chars, signs sessions + CSRF tokens.
# Generate: openssl rand -hex 32
# Changing it later invalidates every existing session.
AUTH_SECRET=

# [REQUIRED] The single private account, used only by the first-run setup
# screen (GET /login). There is no public signup route.
OWNER_EMAIL=
OWNER_NAME=

# Optional bootstrap password (min 10 chars). Leave empty to set it yourself on
# the first-run setup screen — recommended, so no password ever travels through
# a text file or a shell history.
OWNER_PASSWORD=

# Optional allow-list of extra emails that may sign in (comma separated).
# Leave empty for strictly single-user mode.
ALLOWED_EMAILS=


# ── 3. Public URL ────────────────────────────────────────────────────────────
# [REQUIRED] Absolute public origin of this deployment, used for links in
# emails, exports and the outreach preview. Must match the domain Vercel serves
# (custom domain if you attach one), with no trailing slash.
APP_URL=https://your-project.vercel.app


# ── 4. AI (the assistant is the core of the app) ─────────────────────────────
# On Vercel you can usually leave this empty: the AI Gateway is reachable
# through the deployment's OIDC token automatically (lib/ai/model.ts).
# Set it only if you use a Gateway API key outside Vercel or need to pin keys.
AI_GATEWAY_API_KEY=

# Optional model overrides (any AI Gateway model id).
AI_MODEL=openai/gpt-5.6-sol
AI_MODEL_FAST=openai/gpt-5.6-mini


# ── 5. File storage ──────────────────────────────────────────────────────────
# [REQUIRED] Uploads parsed server-side (PDF/DOCX/XLSX/CSV/TXT/JSON/images).
# "local" writes to disk and is NOT durable on Vercel — files vanish between
# invocations. Use Blob in production.
FILE_STORAGE=vercel

# [REQUIRED when FILE_STORAGE=vercel] Created by connecting a Vercel Blob
# store to this project (Project → Storage → Blob). Without it the app reports
# file storage as unavailable instead of pretending the upload was saved.
BLOB_READ_WRITE_TOKEN=


# ── 6. Web research (optional, but the agent needs a provider to search) ─────
# Supply at least one, otherwise web search reports UNCONFIGURED rather than
# inventing sources.
TAVILY_API_KEY=            # https://tavily.com  (recommended: returns page content)
BRAVE_SEARCH_API_KEY=      # https://brave.com/search/api/
SERPER_API_KEY=            # https://serper.dev


# ── 7. Email sending (optional: drafting always works, sending needs a provider)
EMAIL_PROVIDER=            # resend | smtp   (empty = sending unavailable)
EMAIL_FROM="Haseeb AI <ai@your-domain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# ── 8. WhatsApp sending (optional: official Business API only) ───────────────
WHATSAPP_PROVIDER=          # meta | twilio   (empty = sending unavailable)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# ── 9. Calendar / booking (optional) ─────────────────────────────────────────
CALENDAR_PROVIDER=          # calcom | calendly  (empty = booking unavailable)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=


# ── 10. Website QA screenshots (optional) ────────────────────────────────────
# Without a provider, audits run with HTTP/DOM analysis and report
# "screenshot: unavailable" — they never claim a screenshot exists.
# Note: on Vercel, screenshots are captured but cannot be persisted unless Blob
# storage is configured (section 5); the audit says so instead of failing.
SCREENSHOT_PROVIDER=        # urlbox | browserless | none
URLBOX_API_KEY=
BROWSERLESS_API_KEY=


# ── 11. Operational limits ───────────────────────────────────────────────────
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
# Keep false: this is the SSRF guard that blocks the agent from fetching
# private ranges and cloud metadata endpoints when it browses the web.
ALLOW_PRIVATE_NETWORK_FETCH=false

# Optional: deploy hook the agent can call after an approved "deploy" action.
VERCEL_DEPLOY_HOOK_URL=


# ── Do NOT set these on Vercel ───────────────────────────────────────────────
# DATA_DIR                 only /tmp is writable and it is per-invocation, so a
#                          SQLite path there would reset constantly. Irrelevant
#                          once DATABASE_URL points at Postgres.
# FILE_STORAGE=local       not durable on serverless (see section 5).
# SMOKE_BASE_URL / SMOKE_EMAIL / SMOKE_PASSWORD
#                          local-only inputs for scripts/smoke.mjs, not runtime
#                          configuration.
# VERCEL_OIDC_TOKEN        injected by Vercel automatically; the app reads it
#                          for AI Gateway auth. Never set it by hand.
